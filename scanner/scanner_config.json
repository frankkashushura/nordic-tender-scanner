    "_web_pages_help": "To watch another Tanzanian tender page, copy one block, change name, url and client. The page must show its list without logging in. must_contain (optional) keeps only notices containing one of those words, e.g. [\"tanzania\"] on an international page. A page that keeps FAILING in last_scan.txt can be switched off with enabled: false.",
    "ddo": {
      "enabled": true,
      "every_minutes": 15,
      "url": "https://www.ddotenders.co.tz/tender.php?page=home",
      "about": "DDO Tenders Portal – newspaper, private-sector, donor, NGO and embassy tenders across Tanzania (public list shows title, company, closing date and place)"
    }
  },
  "min_days_left_to_record": 2,
  "scan_every_minutes": 5,
  "skip_if_previous_scan_running_minutes": 20,
  "places_title_skip": [
    "same",
    "hai",
    "mara"
