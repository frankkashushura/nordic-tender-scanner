{
  "_help": "Settings for the Tanzania Tender Scanner / NORDIC NEXUS. Edit with Notepad. Keep the quotes and commas. Words and place names are lower-case. Never put passwords or keys in this file.",
  "workbook_path": "../data/Nordic_Opportunity_Pipeline.xlsx",
  "owner": "Frank",
  "email_to": "",
  "_email_help": "An email is sent only when tenders appear that were not reported before - never every 15 minutes.",
  "sources": {
    "_help": "every_minutes = how often each source is checked. The Windows schedule runs every hour; a source is read when its own interval has passed. enabled: true/false switches a source on or off.",
    "nest": {
      "enabled": true,
      "every_minutes": 5,
      "about": "NeST – all Mainland Tanzania public tenders (ministries, councils, TANROADS, TARURA, TANESCO, DAWASA, TPA, TPDC, NHC, hospitals, universities ...)"
    },
    "worldbank": {
      "enabled": true,
      "every_minutes": 30,
      "about": "World Bank procurement notices for projects in Tanzania (Mainland and Zanzibar), civil works only",
      "skip_notice_types": [
        "award",
        "general procurement notice"
      ]
    },
    "tanroads": {
      "enabled": true,
      "every_minutes": 15,
      "url": "https://www.tanroads.go.tz/tenders",
      "about": "TANROADS website tender list (includes donor-funded road tenders)"
    },
    "web_pages": [
      {
        "name": "CRDB Bank tenders",
        "url": "https://crdbbank.co.tz/en/about-us/tender",
        "source": "client site",
        "client": "CRDB Bank PLC",
        "client_type": "bank",
        "every_minutes": 60,
        "enabled": true
      },
      {
        "name": "TPA current tenders",
        "url": "https://www.ports.go.tz/index.php/en/procurements/current-tenders-en",
        "source": "client site",
        "client": "Tanzania Ports Authority (TPA)",
        "client_type": "parastatal",
        "every_minutes": 60,
        "enabled": true,
        "about": "Port buildings, yards, jetties and civil works"
      },
      {
        "name": "TARURA tenders",
        "url": "https://tarura.go.tz/trr/matangazo",
        "api_url": "https://tarura.go.tz:6032/api/v1/Documents/document-type-code/PR001",
        "source": "client site",
        "client": "TARURA",
        "client_type": "government",
        "every_minutes": 60,
        "enabled": true,
        "about": "Rural and urban roads, drains, culverts"
      },
      {
        "name": "Bank of Tanzania tenders",
        "url": "https://www.bot.go.tz/CallsforTender",
        "source": "client site",
        "client": "Bank of Tanzania",
        "client_type": "government",
        "every_minutes": 60,
        "enabled": true,
        "about": "BoT branch buildings and renovations"
      },
      {
        "name": "TEITI tenders",
        "url": "https://www.teiti.go.tz/tenders",
        "source": "client site",
        "client": "TEITI",
        "client_type": "government",
        "every_minutes": 60,
        "enabled": true
      }
    ],
    "_web_pages_help": "To watch another Tanzanian tender page, copy one block, change name, url and client. The page must show its list without logging in. must_contain (optional) keeps only notices containing one of those words, e.g. [\"tanzania\"] on an international page. A page that keeps FAILING in last_scan.txt can be switched off with enabled: false. Removed 1 Oct 2026 because they could not be read from GitHub's computers: ZPPDA (address does not exist), NMB and AfDB (refuse automatic readers, 403), TANESCO (JavaScript list, bad certificate), TAA (page removed, 404), RUWASA (closes the connection to foreign servers). Their tenders still reach NEXUS through NeST, DDO Tenders and TanzaniaTenders.com.",
    "ddo": {
      "enabled": true,
      "every_minutes": 15,
      "url": "https://www.ddotenders.co.tz/tender.php?page=home",
      "about": "DDO Tenders Portal – newspaper, private-sector, donor, NGO and embassy tenders across Tanzania (public list shows title, company, closing date and place)"
    },
    "tanzaniatenders": {
      "enabled": true,
      "every_minutes": 30,
      "url": "https://www.tanzaniatenders.com/tenders.php",
      "pages": 5,
      "about": "TanzaniaTenders.com – newspaper, government-portal and private tenders across Tanzania (public list shows title, TZT reference and deadline; 10 per page, the first 5 pages are read)"
    }
  },
  "min_days_left_to_record": 2,
  "always_keep_words": [
    "construction",
    "construct",
    "constructing",
    "ujenzi",
    "kujenga"
  ],
  "_always_keep_words_help": "Tenders whose title has one of these words are never screened out for distance or type - they reach NEXUS as Check. Closed, closing in under 2 days, and 'exclude' words (e.g. borehole) still apply.",
  "scan_every_minutes": 5,
  "skip_if_previous_scan_running_minutes": 20,
  "places_title_skip": [
    "same",
    "hai",
    "mara"
  ],
  "_places_title_skip_help": "Place names that are also ordinary words; used only when matching the procuring entity district, not the tender title.",
  "location_score": {
    "near": 5,
    "mid": 4,
    "lindi": 3,
    "far": 1
  },
