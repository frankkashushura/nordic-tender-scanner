{
  "_help": "Settings for the Tanzania Tender Scanner / NORDIC NEXUS. Edit with Notepad. Keep the quotes and commas. Words and place names are lower-case. Never put passwords or keys in this file.",
  "workbook_path": "../data/Nordic_Opportunity_Pipeline.xlsx",
  "owner": "Frank",
  "email_to": "",
  "_email_help": "An email is sent only when tenders appear that were not reported before - never every 15 minutes.",
  "sources": {
    "_help": "every_minutes = how often each source is checked. The Windows schedule runs every hour; a source is read when its own interval has passed. enabled: true/false switches a source on or off.",
    "nest": {
      "enabled": true,
      "every_minutes": 5,
      "about": "NeST – all Mainland Tanzania public tenders (ministries, councils, TANROADS, TARURA, TANESCO, DAWASA, TPA, TPDC, NHC, hospitals, universities ...)"
    },
    "worldbank": {
      "enabled": true,
      "every_minutes": 30,
      "about": "World Bank procurement notices for projects in Tanzania (Mainland and Zanzibar), civil works only",
      "skip_notice_types": [
        "award",
        "general procurement notice"
      ]
    },
    "tanroads": {
      "enabled": true,
      "every_minutes": 15,
      "url": "https://www.tanroads.go.tz/tenders",
      "about": "TANROADS website tender list (includes donor-funded road tenders)"
    },
