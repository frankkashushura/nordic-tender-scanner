  "documents_folder": "",
  "_documents_help": "A folder is created here for every new Pursue/Check tender, with a shortcut to its NeST page. Staff log in to NeST, download the document and save it in that folder.",
  "alerts": {
    "enabled": false,
    "_help": "Run '3 - Save alert keys.bat' to set up email, SMS and WhatsApp and switch alerts on. One digest per person per channel: new Pursue/Check tenders and reminders 7, 3 and 1 day(s) before deadlines. Each item is sent once.",
    "deadline_days": [
      7,
      3,
      1
    ],
    "email": {
      "enabled": false,
      "method": "smtp",
      "smtp_host": "mail.nordictz.co.tz",
      "smtp_port": 465,
      "smtp_user": "",
      "from": "",
      "_help": "Company mail server of nordictz.co.tz. Use a mailbox such as tenders@nordictz.co.tz (create it in the hosting control panel). method 'outlook' uses Outlook on this PC instead."
    },
    "sms": {
      "enabled": false,
      "provider": "Beem Africa",
      "url": "https://apisms.beem.africa/v1/send",
      "sender_id": "INFO",
      "_help": "Open a Beem account (beem.africa), apply for sender ID NORDIC, then save the API key and secret with '3 - Save alert keys.bat'."
    },
    "whatsapp": {
      "enabled": false,
      "phone_number_id": "",
      "api_version": "v21.0",
      "template": "tender_alert",
      "language": "en",
      "_help": "Needs a WhatsApp Business Cloud API number (Meta Business account) and an approved template named tender_alert with one body variable {{1}}. Save the access token with '3 - Save alert keys.bat'."
    },
    "recipients": [],
    "_recipients_help": "Staff come automatically from the NEXUS Staff page (recipients.json, refreshed by the NEXUS sync): their email, phone and alert choices. Add people who are not staff here, e.g. {\"name\":\"...\",\"email\":\"...\",\"phone\":\"+2557...\",\"by_email\":true,\"by_sms\":false,\"by_whatsapp\":false,\"gets\":[\"new\",\"deadline\"]}."
  },
  "_cloud_help": "Cloud copy for GitHub Actions. Alerts stay off until the office PC scanner is switched off, so nobody gets double alerts. Keys come from GitHub Secrets, never from this file."
}